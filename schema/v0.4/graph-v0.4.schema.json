{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.byaml.org/v0.4/graph.schema.json",
  "title": "BYaML Architecture Graph v0.4",
  "description": "SOFE Architecture Graph — graph-first model. Nodes = resources/services, edges = typed relationships, attributes = cost/findings/owners. Derived from scan (SOFE) or IaC (Terraform/CDK), not handwritten. Serialization is a wire format for interop/debug; the product is the graph.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.4",
      "description": "Schema version"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*[a-z0-9]$",
      "description": "Optional graph identifier (kebab-case)"
    },
    "generated_from": {
      "$ref": "#/$defs/GeneratedFrom",
      "description": "Provenance: how this graph was produced (scan / IaC plan)"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/Edge" }
    },
    "insights": {
      "$ref": "#/$defs/Insights",
      "description": "Optional precomputed insights (spof, blast radius, cost chains). Consumed by nan-graph; may be empty on serialization."
    }
  },
  "$defs": {
    "GeneratedFrom": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["sofe", "terraform", "cdk", "cloudformation", "manual", "aws"],
          "description": "Source of the graph"
        },
        "eval_id": { "type": "string" },
        "account": { "type": "string" },
        "scanned_at": { "type": "string", "format": "date-time" },
        "provider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "multi"]
        }
      }
    },
    "Node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node id (resource id / service name)"
        },
        "type": {
          "type": "string",
          "description": "Resource/service type, e.g. aws.lambda. Must exist in catalog.yaml (custom types allowed)."
        },
        "layer": {
          "type": "string",
          "enum": ["edge", "networking", "compute", "data", "storage", "security", "integration", "observability", "other"]
        },
        "region": { "type": "string" },
        "account": { "type": "string" },
        "label": { "type": "string" },
        "cost": {
          "type": "object",
          "properties": {
            "monthly": { "type": "number" },
            "currency": { "type": "string", "default": "USD" },
            "tags": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        },
        "findings": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "worst": { "type": ["string", "null"] },
            "policies": { "type": "array", "items": { "type": "string" } }
          }
        },
        "owner": { "type": "string" },
        "attributes": {
          "type": "object",
          "description": "Free-form attributes (tags, healthUrl, repo, runtime...)"
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "description": "Source node id" },
        "to": { "type": "string", "description": "Target node id" },
        "type": {
          "type": "string",
          "description": "Relationship type. Validated against relationships.yaml matrix (WARNING if unknown).",
          "examples": ["invokes", "reads_writes", "routes_to", "depends_on", "hosts", "triggers", "calls"]
        },
        "label": { "type": "string" },
        "weight": { "type": "number" }
      },
      "additionalProperties": false
    },
    "Insights": {
      "type": "object",
      "properties": {
        "spof": { "type": "array", "items": { "type": "string" } },
        "blast_radius": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "cost_chains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "array", "items": { "type": "string" } },
              "monthly": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
